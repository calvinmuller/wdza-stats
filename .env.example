# Postgres connection used by both apps/worker and apps/web.
DATABASE_URL=postgres://wdza:wdza@localhost:54329/wdza_stats

# Used only by packages/db's test suite; a separate database on the same
# local Postgres instance (created automatically by docker-compose).
TEST_DATABASE_URL=postgres://wdza:wdza@localhost:54329/wdza_stats_test

# The WDZA server this deployment tracks. RCON_TOKEN is read only by
# apps/worker's RCON client (ticket 02) - it is never persisted to the
# database and never reaches apps/web.
SERVER_NAME="[WDZA] WARDOGS South Africa Community Server"
RCON_BASE_URL=http://165.217.136.112:9006
RCON_TOKEN=

# Steam Web API key (ticket 02) - read only by apps/worker's Steam client to
# fetch player avatars/names/achievements. Never persisted to the database
# and never reaches apps/web. Generate one at
# https://steamcommunity.com/dev/apikey against the account/domain that
# operates this deployment.
STEAM_API_KEY=

# Signs Staff Member session cookies (Better Auth). Any long random string;
# changing it signs every Staff Member out. Generate one with `openssl rand -hex 32`.
BETTER_AUTH_SECRET=

# The site's public origin, e.g. https://stats.example.com. Better Auth checks
# request origins against it, and Steam sign-in for Verified Players uses it as
# the OpenID realm and return URL; leave empty only for local development.
BETTER_AUTH_URL=

# Unguessable URL path segment for the staff bootstrap page (ADR 0005): visiting
# https://<host>/<this value>/bootstrap creates the first admin while none exists
# and resets an admin's password when no admin can sign in. It is NOT an admin
# login any more (staff sign in at /admin/sign-in), but it is the recovery path,
# so keep it long and secret.
ADMIN_PATH_SECRET=
